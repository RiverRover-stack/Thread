# Copy this file to .env.local. Never commit actual credentials.
# Required for database access; the foundation homepage works without it.
# Keep this local development database separate from production. Render's Blueprint
# supplies its own database URL; do not copy production credentials into this file.
# Format: postgresql://USER:PASSWORD@localhost:5432/thread?schema=public
DATABASE_URL=

# Required for transcription. Server-side only; enable speech-to-text access.
ELEVENLABS_API_KEY=

# Reasoning provider: ollama (default, local PC) or google (hosted Gemma).
# Set AI_PROVIDER=google on Render. Restart the app after changing settings.
AI_PROVIDER=ollama
# Google AI Studio server-side key; never use NEXT_PUBLIC_ or put it in a URL.
GEMINI_API_KEY=
GOOGLE_GEMMA_MODEL=gemma-4-26b-a4b-it

# Shared demo gate. Enter this password at /login. Optional locally; required
# in production. Render generates a password. If set, use 16–256 characters.
THREAD_ACCESS_PASSWORD=

# Local structured-thought inference through Ollama. These defaults are optional.
# Used only when the corresponding provider is ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Local embedding model for semantic search, configured separately from structuring.
# Set EMBEDDING_PROVIDER=google on Render to use gemini-embedding-2 at 768 dimensions.
# Changing embedding providers for an existing database requires reindexing.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m

# Minimum cosine similarity for related thoughts; tune using real examples.
# Local starting point: 0.70. Render uses a preliminary Google starting point of 0.80.
RELATED_THOUGHTS_MIN_SIMILARITY=0.70

# Optional server-only Sentry AI tracing. Blank disables monitoring.
# Set sample rate to 1 for synthetic demo verification; default is 0.1.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# CHALLENGE: control trace volume without changing the capture flow.
# TODO(you): after connecting a local Sentry project, try a rate of 1, then 0.
# Hint 1: 1 samples every trace. Hint 2: 0 samples none. Hint 3: restart after editing.
# Verify: synthetic capture works in both cases; only rate 1 produces new traces.
