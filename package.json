{
  "name": "thread",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "ai:eval": "node --conditions=react-server --import tsx scripts/evaluate-ai.ts",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:verify": "node --conditions=react-server --import tsx scripts/verify-persistence.ts",
    "timeline:verify": "node --conditions=react-server --import tsx scripts/verify-timeline.ts",
    "detail:verify": "node --conditions=react-server --import tsx scripts/verify-thought-detail.ts",
    "db:validate": "prisma validate",
    "db:check": "node scripts/check-db.mjs",
    "memory:check": "node scripts/check-semantic-memory.mjs",
    "memory:check:db": "node scripts/check-semantic-memory.mjs --database",
    "memory:check:embedding": "node scripts/check-semantic-memory.mjs --embedding",
    "embeddings:eval": "node --conditions=react-server --import tsx scripts/evaluate-embeddings.ts",
    "embeddings:backfill": "node --conditions=react-server --import tsx scripts/backfill-embeddings.ts",
    "embeddings:verify": "node --conditions=react-server --import tsx scripts/verify-embeddings.ts",
    "related:verify": "node --conditions=react-server --import tsx scripts/verify-related-thoughts.ts",
    "memory:eval": "node --conditions=react-server --import tsx scripts/evaluate-memory.ts",
    "memory:detail:verify": "node --conditions=react-server --import tsx scripts/verify-memory-detail.ts"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
